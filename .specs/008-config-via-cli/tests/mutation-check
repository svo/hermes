fi'

mutate 'a failed doctor is not mentioned' \
  'if [ "$doctor_status" -ne 0 ]; then
  {
    echo "doctor:' \
  'if false; then
  {
    echo "doctor:'

mutate 'a failed doctor takes the container down' \
  '    redact_secrets "$doctor_output" | tail -n 5 | sed '"'"'s/^/    /'"'"'
  } >&2
fi' \
  '    redact_secrets "$doctor_output" | tail -n 5 | sed '"'"'s/^/    /'"'"'
  } >&2
  exit 1
fi'

mutate "a failed doctor's report is printed without redacting it" \
  '    redact_secrets "$doctor_output" | tail -n 5 | sed' \
  '    printf '"'"'%s\n'"'"' "$doctor_output" | tail -n 5 | sed'

mutate 'a failed migration takes the container down' \
  "      echo '  Otherwise fix what doctor reported above and restart.'" \
  "      echo '  Otherwise fix what doctor reported above and restart.'
      exit 1"

mutate 'the migration verdict is taken from the exit code' \
  '  if [ ! -f "$HOME/.openclaw/exec-approvals.json" ]; then
    echo '"'"'approvals: migrated' \
  '  if [ "$doctor_status" -eq 0 ]; then
    echo '"'"'approvals: migrated'

mutate "doctor's report is printed without redacting it" \
  '        redact_secrets "$doctor_output" | tail -n 5' \
  '        printf '"'"'%s\n'"'"' "$doctor_output" | tail -n 5'

mutate 'the tool profile is set to full, which now adds plugin tools' \
  "        profile: null," \
  "        profile: 'full',"

mutate 'messages are answered by the small model again' \
  "    const chatModel = 'anthropic/claude-opus-5';" \
  "    const chatModel = 'anthropic/claude-haiku-4-5';"

mutate 'the heartbeat runs on the larger model' \
  '            model: utilityModel,' \
  '            model: chatModel,'

mutate 'compaction runs on the larger model' \
  '          compaction: { model: utilityModel },' \
  '          compaction: { model: chatModel },'

mutate 'the larger model is left on the default cache' \
  "            [chatModel]: {
              params: { cacheRetention: 'long' }
            }," \
  ''

printf '\n'
if [ "$skipped" -gt 0 ]; then
  printf '%d mutation(s) skipped by the filter.\n' "$skipped"
fi
if [ ${#missed[@]} -eq 0 ]; then
  printf 'Every mutation was caught.\n'
  exit 0
fi
printf '%d mutation(s) survived or could not be applied:\n' "${#missed[@]}" >&2
printf '  %s\n' "${missed[@]}" >&2
exit 1
