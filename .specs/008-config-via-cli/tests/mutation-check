  'doctor_output="$(rm -f "$HOME/.openclaw/exec-approvals.json" 2>&1)" || doctor_status=$?'

mutate 'doctor runs only when a legacy file exists' \
  'doctor_output="$(openclaw doctor --fix --non-interactive 2>&1)" || doctor_status=$?' \
  'doctor_output='"'"''"'"'
if [ "$legacy_approvals" = '"'"'yes'"'"' ]; then
