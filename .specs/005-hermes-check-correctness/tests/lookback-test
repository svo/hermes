should_replace_a_bad_record_when_the_fetch_works() {
  case_start "${FUNCNAME[0]}"
  local home
  home="$(new_home)"
  seed_record "$home" "yesterday"
  run_check --home "$home" gmail-clean.json calendar-clean.json
  case "$(cat "$(record_path "$home")")" in
    '' | *[!0-9]*) fail "the bad record was left in place: $(cat "$(record_path "$home")")" ;;
  esac
  assert_universal_invariants
  case_end
}

should_say_so_when_gog_had_more_mail_than_it_returned() {
  case_start "${FUNCNAME[0]}"
  run_check \
    '{"messages":[{"id":"m-1","subject":"Lunch","from":"alice@example.net"}],"nextPageToken":"08157432"}' \
    calendar-empty.json
  assert_equals "flagged" "yes" "$(field FETCH_TRUNCATED)"
  assert_equals "worth a message" "yes" "$(field ACTION_NEEDED)"
  assert_contains "and says why" "$(field REASONS)" "more unread mail than was checked"
  assert_universal_invariants
  case_end
}

should_not_say_so_when_gog_returned_everything() {
  case_start "${FUNCNAME[0]}"
  run_check \
    '{"messages":[{"id":"m-1","subject":"Lunch","from":"alice@example.net"}]}' \
    calendar-empty.json
  assert_equals "not flagged" "no" "$(field FETCH_TRUNCATED)"
  assert_not_contains "no reason given" "$RUN_OUT" "more unread mail than was checked"
  assert_universal_invariants
  case_end
}

should_not_say_so_when_the_next_page_is_empty() {
  case_start "${FUNCNAME[0]}"
  run_check \
    '{"messages":[{"id":"m-1","subject":"Lunch","from":"alice@example.net"}],"nextPageToken":""}' \
    calendar-empty.json
  assert_equals "not flagged" "no" "$(field FETCH_TRUNCATED)"
  assert_universal_invariants
  case_end
}

should_not_say_so_when_the_fetch_failed() {
  case_start "${FUNCNAME[0]}"
  run_check gmail-not-json.html calendar-empty.json
  assert_equals "not flagged" "no" "$(field FETCH_TRUNCATED)"
  assert_universal_invariants
  case_end
}

should_not_report_a_message_again_when_many_were_seen_since() {
  case_start "${FUNCNAME[0]}"
  local home
  home="$(new_home)"
  mkdir -p "$home/.openclaw/hermes-check"
  {
    printf 'msg-clean-1\n'
    seq -f 'filler-%g' 1 600
  } > "$(seen_path "$home")"
  run_check --home "$home" gmail-clean.json calendar-clean.json
  assert_equals "first run: only the unseen one" "1" "$(field NEW_UNREAD)"
  run_check --home "$home" gmail-clean.json calendar-clean.json
  assert_equals "second run: nothing new" "0" "$(field NEW_UNREAD)"
  assert_universal_invariants
  case_end
}

should_forget_the_oldest_ids_when_more_than_a_thousand_are_remembered() {
  case_start "${FUNCNAME[0]}"
  local home
  home="$(new_home)"
  mkdir -p "$home/.openclaw/hermes-check"
  seq -f 'filler-%g' 1 1500 > "$(seen_path "$home")"
  run_check --home "$home" gmail-clean.json calendar-clean.json
  assert_equals "kept" "1000" "$(wc -l < "$(seen_path "$home")" | tr -d ' ')"
  assert_equals "the newest survive" "1" \
    "$(grep -cxF 'msg-clean-2' "$(seen_path "$home")")"
  assert_equals "the oldest do not" "0" \
    "$(grep -cxF 'filler-1' "$(seen_path "$home")")"
  assert_universal_invariants
  case_end
}

