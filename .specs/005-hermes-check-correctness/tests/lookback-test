#!/usr/bin/env bash

set -uo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=harness.sh
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/harness.sh"

record_path() {
  printf '%s/.openclaw/hermes-check/last-mail-fetch' "$1"
}

seen_path() {
  printf '%s/.openclaw/hermes-check/seen-messages.txt' "$1"
}

seed_record() {
  mkdir -p "$1/.openclaw/hermes-check"
  printf '%s\n' "$2" > "$(record_path "$1")"
}

seconds_ago() {
  printf '%s' "$(($(date +%s) - $1))"
}

queries() {
  grep '^ARG \[is:unread ' "$1" || true
}

should_look_back_two_hours_when_no_fetch_is_recorded() {
  case_start "${FUNCNAME[0]}"
  local log
  log="$(new_log)"
  run_check --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "query" 'ARG [is:unread newer_than:2h]' "$(queries "$log")"
  assert_equals "reported" "2" "$(field LOOKBACK_HOURS)"
  assert_universal_invariants
  case_end
}

should_look_back_two_hours_when_the_last_fetch_was_one_heartbeat_ago() {
  case_start "${FUNCNAME[0]}"
  local home log
  home="$(new_home)"
  log="$(new_log)"
  seed_record "$home" "$(seconds_ago $((59 * 60)))"
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "query" 'ARG [is:unread newer_than:2h]' "$(queries "$log")"
  assert_equals "reported" "2" "$(field LOOKBACK_HOURS)"
  assert_universal_invariants
  case_end
}

should_look_back_to_the_last_fetch_when_it_was_the_evening_before() {
  case_start "${FUNCNAME[0]}"
  local home log
  home="$(new_home)"
  log="$(new_log)"
  seed_record "$home" "$(seconds_ago $((12 * 3600 + 1800)))"
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "query" 'ARG [is:unread newer_than:14h]' "$(queries "$log")"
  assert_equals "reported" "14" "$(field LOOKBACK_HOURS)"
  assert_universal_invariants
  case_end
}

should_cover_a_part_hour_when_the_last_fetch_was_just_over_two_hours_ago() {
  case_start "${FUNCNAME[0]}"
  local home log
  home="$(new_home)"
  log="$(new_log)"
  seed_record "$home" "$(seconds_ago $((2 * 3600 + 600)))"
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "query" 'ARG [is:unread newer_than:4h]' "$(queries "$log")"
  assert_universal_invariants
  case_end
}

should_stop_at_a_week_when_the_last_fetch_was_a_month_ago() {
  case_start "${FUNCNAME[0]}"
  local home log
  home="$(new_home)"
  log="$(new_log)"
  seed_record "$home" "$(seconds_ago $((30 * 86400)))"
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "query" 'ARG [is:unread newer_than:168h]' "$(queries "$log")"
  assert_equals "reported" "168" "$(field LOOKBACK_HOURS)"
  assert_universal_invariants
  case_end
}

should_record_when_the_fetch_began_when_the_fetch_works() {
  case_start "${FUNCNAME[0]}"
  local home before after recorded
  home="$(new_home)"
  before="$(date +%s)"
  run_check --home "$home" gmail-clean.json calendar-clean.json
  after="$(date +%s)"
  recorded="$(cat "$(record_path "$home")" 2>/dev/null)"
  case "$recorded" in
    '' | *[!0-9]*) fail "the record is not a whole number of seconds: '${recorded}'" ;;
    *)
      if [ "$recorded" -lt "$before" ] || [ "$recorded" -gt "$after" ]; then
        fail "recorded ${recorded}, outside the run (${before}..${after})"
      fi
      ;;
  esac
  assert_universal_invariants
  case_end
}

should_narrow_the_window_again_when_the_long_fetch_worked() {
  case_start "${FUNCNAME[0]}"
  local home log
  home="$(new_home)"
  log="$(new_log)"
  seed_record "$home" "$(seconds_ago $((12 * 3600 + 1800)))"
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "first long, second short" \
    'ARG [is:unread newer_than:14h]
ARG [is:unread newer_than:2h]' "$(queries "$log")"
  assert_universal_invariants
  case_end
}

should_keep_the_earlier_record_when_the_fetch_fails() {
  case_start "${FUNCNAME[0]}"
  local home log earlier
  home="$(new_home)"
  log="$(new_log)"
  earlier="$(seconds_ago $((5 * 3600 + 1800)))"
  seed_record "$home" "$earlier"
  run_check --home "$home" --argv-log "$log" gmail-not-json.html calendar-clean.json
  assert_equals "the fetch did fail" "1" "$(field DATA_SOURCE_ERRORS)"
  assert_equals "record untouched" "$earlier" "$(cat "$(record_path "$home")")"
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "both runs reach back to the same fetch" \
    'ARG [is:unread newer_than:7h]
ARG [is:unread newer_than:7h]' "$(queries "$log")"
  assert_universal_invariants
  case_end
}

should_record_nothing_when_the_first_fetch_fails() {
  case_start "${FUNCNAME[0]}"
  local home
  home="$(new_home)"
  run_check --home "$home" gmail-not-json.html calendar-clean.json
  assert_equals "the fetch did fail" "1" "$(field DATA_SOURCE_ERRORS)"
  if [ -e "$(record_path "$home")" ]; then
    fail "a failed fetch left a record: $(cat "$(record_path "$home")")"
  fi
  assert_universal_invariants
  case_end
}

should_record_the_fetch_when_only_the_calendar_fails() {
  case_start "${FUNCNAME[0]}"
  local home
  home="$(new_home)"
  run_check --home "$home" gmail-clean.json 'not json at all'
  assert_equals "the calendar did fail" "1" "$(field DATA_SOURCE_ERRORS)"
  if [ ! -s "$(record_path "$home")" ]; then
    fail "the mail fetch worked and was not recorded"
  fi
  assert_universal_invariants
  case_end
}

should_keep_the_earlier_record_when_the_run_is_killed_while_reading_the_mail() {
  case_start "${FUNCNAME[0]}"
  local home log earlier
  home="$(new_home)"
  log="$(new_log)"
  earlier="$(seconds_ago $((12 * 3600 + 1800)))"
  seed_record "$home" "$earlier"
  run_check --home "$home" gmail-clean.json calendar-clean.json FASTTEXT_KILLS_CALLER=yes 2>/dev/null
  assert_equals "the run was killed" "137" "$RUN_STATUS"
  assert_equals "record" "$earlier" "$(cat "$(record_path "$home")")"
  run_check --home "$home" --argv-log "$log" gmail-clean.json calendar-clean.json
  assert_equals "the next run looks back again" \
    'ARG [is:unread newer_than:14h]' "$(queries "$log")"
  assert_universal_invariants
  case_end
}

