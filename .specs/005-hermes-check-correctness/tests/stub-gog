#!/usr/bin/env bash

set -uo pipefail

if [ -n "${GOG_ARGV_LOG:-}" ]; then
  {
    printf 'INVOCATION %s %d\n' "${1:-none}" "$#"
    for arg in "$@"; do
      printf 'ARG [%s]\n' "$arg"
    done
  } >> "$GOG_ARGV_LOG"
fi

case "${1:-}" in
  gmail) fixture="${GOG_FIXTURE_GMAIL:-${GOG_FIXTURE:-}}" ;;
  calendar) fixture="${GOG_FIXTURE_CALENDAR:-${GOG_FIXTURE:-}}" ;;
  *) fixture="${GOG_FIXTURE:-}" ;;
esac

if [ -n "$fixture" ]; then
  if [ -f "$fixture" ]; then
    cat "$fixture"
  else
    printf '%s\n' "$fixture"
  fi
fi

exit "${GOG_FIXTURE_EXIT:-0}"
