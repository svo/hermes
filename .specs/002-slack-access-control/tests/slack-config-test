#!/usr/bin/env bash
#
# The accepted configurations: what the entrypoint writes into openclaw.json
# when SLACK_BOT_TOKEN is set and the access-control variables are well formed.
#
# The shape matters more than it looks. Slack gates DMs on dmPolicy + allowFrom
# like Telegram, but gates groups on groupPolicy + a channels map keyed by
# channel ID — there is no wildcard. Copying Telegram's groups: { '*': ... }
# would produce a config that reads as gated and is not, which is finding A2d.

set -uo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=harness.sh
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/harness.sh"

SLACK_ENV=(SLACK_BOT_TOKEN=xoxb-test-bot-token SLACK_APP_TOKEN=xapp-test-app-token)

should_set_dm_policy_to_allowlist_when_slack_allow_from_is_set() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE,U0456FGHIJ
  assert_equals "entrypoint succeeded" "0" "$RUN_STATUS"
  assert_equals "dmPolicy" "allowlist" "$(config_get '.channels.slack.dmPolicy')"
  assert_equals "allowFrom" '["U0123ABCDE","U0456FGHIJ"]' "$(config_get '.channels.slack.allowFrom')"
  case_end
}

should_trim_entries_when_slack_allow_from_has_surrounding_whitespace() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM='  U0123ABCDE ,  U0456FGHIJ  ,, '
  assert_equals "entrypoint succeeded" "0" "$RUN_STATUS"
  assert_equals "trimmed and emptied entries dropped" \
    '["U0123ABCDE","U0456FGHIJ"]' "$(config_get '.channels.slack.allowFrom')"
  case_end
}

should_pass_access_group_entries_through_untouched_when_allow_from_contains_them() {
  case_start "${FUNCNAME[0]}"
  # The documented accessGroup:<name> form contains a colon. Entries are passed
  # through unparsed, so it must survive rather than be rejected as malformed.
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM='U0123ABCDE,accessGroup:on-call'
  assert_equals "entrypoint succeeded" "0" "$RUN_STATUS"
  assert_equals "accessGroup entry preserved" \
    '["U0123ABCDE","accessGroup:on-call"]' "$(config_get '.channels.slack.allowFrom')"
  case_end
}

should_disable_group_policy_when_no_channels_are_supplied() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE
  assert_equals "entrypoint succeeded" "0" "$RUN_STATUS"
  assert_equals "groupPolicy closed by default" "disabled" "$(config_get '.channels.slack.groupPolicy')"
  assert_equals "no channel allowlisted" "{}" "$(config_get '.channels.slack.channels')"
  case_end
}

should_allowlist_each_channel_with_mention_required_when_channels_are_supplied() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE \
    SLACK_ALLOW_CHANNELS=' C0123ABCDE , G0456FGHIJ '
  assert_equals "entrypoint succeeded" "0" "$RUN_STATUS"
  assert_equals "groupPolicy" "allowlist" "$(config_get '.channels.slack.groupPolicy')"
  assert_equals "public channel entry" '{"enabled":true,"requireMention":true}' \
    "$(config_get '.channels.slack.channels.C0123ABCDE')"
  assert_equals "private channel entry" '{"enabled":true,"requireMention":true}' \
    "$(config_get '.channels.slack.channels.G0456FGHIJ')"
  case_end
}

should_not_write_a_telegram_shaped_groups_key_when_slack_is_configured() {
  case_start "${FUNCNAME[0]}"
  # Slack has no wildcard group key: `groups` is not a key it has at all, and a
  # channels map keyed by '*' is not a channel ID. Absence is the assertion —
  # so the case also has to prove the block ran and wrote something, or it
  # would pass against an entrypoint that writes no Slack config whatsoever.
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE SLACK_ALLOW_CHANNELS=C0123ABCDE
  assert_equals "entrypoint succeeded" "0" "$RUN_STATUS"
  assert_equals "the channel was written" '{"enabled":true,"requireMention":true}' \
    "$(config_get '.channels.slack.channels.C0123ABCDE')"
  assert_equals "no groups key" "null" "$(config_get '.channels.slack.groups')"
  assert_equals "no wildcard channel key" "null" "$(config_get '.channels.slack.channels["*"]')"
  case_end
}

should_preserve_the_socket_mode_and_both_tokens_when_access_control_is_added() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE
  assert_equals "enabled" "true" "$(config_get '.channels.slack.enabled')"
  assert_equals "mode" "socket" "$(config_get '.channels.slack.mode')"
  assert_equals "botToken" "xoxb-test-bot-token" "$(config_get '.channels.slack.botToken')"
  assert_equals "appToken" "xapp-test-app-token" "$(config_get '.channels.slack.appToken')"
  case_end
}

should_exit_zero_from_config_validate_when_only_dms_are_allowed() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE
  config_validate >/dev/null 2>"${RUN_DIR}/validate.err"
  assert_equals "config validate exit status" "0" "$?"
  assert_equals "no schema problems" "" "$(cat "${RUN_DIR}/validate.err")"
  case_end
}

should_exit_zero_from_config_validate_when_channels_are_allowlisted() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE SLACK_ALLOW_CHANNELS=C0123ABCDE
  config_validate >/dev/null 2>"${RUN_DIR}/validate.err"
  assert_equals "config validate exit status" "0" "$?"
  assert_equals "no schema problems" "" "$(cat "${RUN_DIR}/validate.err")"
  case_end
}

should_reject_a_telegram_shaped_groups_key_when_config_validate_runs() {
  case_start "${FUNCNAME[0]}"
  # Guards the guard. Every other validate case asserts a zero exit, which a
  # validator that always succeeded would also produce — so nothing yet proves
  # the schema transcription can reject anything. A2d is the shape it exists
  # for, so A2d is the shape it gets fed.
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE
  local rewritten="${RUN_DIR}/with-groups.json"
  jq '.channels.slack.groups = {"*": {"requireMention": true}}' "$RUN_CONFIG" > "$rewritten"
  mv "$rewritten" "$RUN_CONFIG"
  local problems
  problems="$(config_validate 2>&1)"
  assert_equals "config validate exit status" "1" "$?"
  assert_contains "names the key" "$problems" "channels.slack.groups: unrecognised key"
  case_end
}

should_reject_a_key_slack_omits_when_config_validate_runs() {
  case_start "${FUNCNAME[0]}"
  # groupAllowFrom is valid on every other channel and omitted from Slack's
  # schema; allowFrom is valid at the Slack root and omitted from the
  # per-channel entry. Both are the shapes an author would reach for.
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE SLACK_ALLOW_CHANNELS=C0123ABCDE
  local rewritten="${RUN_DIR}/with-omitted-keys.json"
  jq '.channels.slack.groupAllowFrom = ["U0123ABCDE"]
      | .channels.slack.channels.C0123ABCDE.allowFrom = ["U0123ABCDE"]' \
    "$RUN_CONFIG" > "$rewritten"
  mv "$rewritten" "$RUN_CONFIG"
  local problems
  problems="$(config_validate 2>&1)"
  assert_equals "config validate exit status" "1" "$?"
  assert_contains "names groupAllowFrom" "$problems" "channels.slack.groupAllowFrom: unrecognised key"
  assert_contains "names the per-channel allowFrom" "$problems" \
    "channels.slack.channels.C0123ABCDE.allowFrom: unrecognised key"
  case_end
}

should_log_the_policies_and_the_entry_counts_when_the_channel_is_configured() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE,U0456FGHIJ \
    SLACK_ALLOW_CHANNELS=C0123ABCDE
  assert_contains "startup line" "$RUN_OUT" \
    'slack: dmPolicy=allowlist allowFrom=2 groupPolicy=allowlist channels=1'
  case_end
}

should_not_log_a_token_or_an_id_when_the_channel_is_configured() {
  case_start "${FUNCNAME[0]}"
  # Counts only. IDs would leak workspace membership into the container log and
  # tokens must never reach it at all.
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE SLACK_ALLOW_CHANNELS=C0123ABCDE
  local logged="${RUN_OUT}${RUN_ERR}"
  assert_not_contains "bot token absent" "$logged" "xoxb-test-bot-token"
  assert_not_contains "app token absent" "$logged" "xapp-test-app-token"
  assert_not_contains "user id absent" "$logged" "U0123ABCDE"
  assert_not_contains "channel id absent" "$logged" "C0123ABCDE"
  case_end
}

should_start_the_gateway_when_the_configuration_is_accepted() {
  case_start "${FUNCNAME[0]}"
  run_entrypoint "${SLACK_ENV[@]}" SLACK_ALLOW_FROM=U0123ABCDE
  if gateway_started; then :; else fail "gateway was never reached"; fi
  case_end
}

should_not_configure_slack_when_no_bot_token_is_set() {
  case_start "${FUNCNAME[0]}"
  # SLACK_ALLOW_FROM is required *with* the token, not on its own: an operator
  # who is not using Slack must not be forced to configure it.
  run_entrypoint
  assert_equals "entrypoint succeeded" "0" "$RUN_STATUS"
  assert_equals "slack absent" "null" "$(config_get '.channels.slack')"
  if gateway_started; then :; else fail "gateway was never reached"; fi
  case_end
}

should_set_dm_policy_to_allowlist_when_slack_allow_from_is_set
should_trim_entries_when_slack_allow_from_has_surrounding_whitespace
should_pass_access_group_entries_through_untouched_when_allow_from_contains_them
should_disable_group_policy_when_no_channels_are_supplied
should_allowlist_each_channel_with_mention_required_when_channels_are_supplied
should_not_write_a_telegram_shaped_groups_key_when_slack_is_configured
should_preserve_the_socket_mode_and_both_tokens_when_access_control_is_added
should_exit_zero_from_config_validate_when_only_dms_are_allowed
should_exit_zero_from_config_validate_when_channels_are_allowlisted
should_reject_a_telegram_shaped_groups_key_when_config_validate_runs
should_reject_a_key_slack_omits_when_config_validate_runs
should_log_the_policies_and_the_entry_counts_when_the_channel_is_configured
should_not_log_a_token_or_an_id_when_the_channel_is_configured
should_start_the_gateway_when_the_configuration_is_accepted
should_not_configure_slack_when_no_bot_token_is_set

report_totals "slack-config-test"
