#!/usr/bin/env bash

set -euo pipefail

state_dir="${STUB_OPENCLAW_STATE:-${HOME}/.stub-openclaw}"
automations_dir="${state_dir}/automations"
config_path="${HOME}/.openclaw/openclaw.json"
seed_path="${state_dir}/seed.json"

log_invocation() {
  if [ -z "${OPENCLAW_ARGV_LOG:-}" ]; then
    return 0
  fi

  local -a words=()
  local arg
  for arg in "$@"; do
    case "$arg" in
      -*) break ;;
    esac
    words+=("$arg")
    if [ "${#words[@]}" -ge 2 ]; then
      break
    fi
  done

  {
    printf 'INVOCATION [%s] %d\n' "${words[*]:-none}" "$#"
    for arg in "$@"; do
      printf 'ARG [%s]\n' "$arg"
    done
  } >> "$OPENCLAW_ARGV_LOG"
}

unimplemented() {
  {
    printf 'stub-openclaw: unimplemented invocation: %s\n' "$*"
    printf '  entrypoint.sh calls something this stub does not model. Extend the\n'
    printf '  stub rather than loosening it: a stub that answered anything with\n'
    printf '  success would report a configuration the container never wrote.\n'
  } >&2
  exit 64
}

cmd_onboard() {
  local port=3000 bind=lan

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --gateway-port) port="${2:-$port}" ;;
      --gateway-bind) bind="${2:-$bind}" ;;
    esac
    shift
  done

  mkdir -p "${HOME}/.openclaw/workspace" "$state_dir"

  if [ -f "$config_path" ]; then
    printf 'stub-openclaw: onboard skipped, %s already exists\n' "$config_path"
    return 0
  fi

  cat > "$config_path" <<SEED
{
  "agents": {
    "defaults": {
      "workspace": "${HOME}/.openclaw/workspace",
      "model": {
        "primary": "anthropic/claude-opus-5"
      },
      "models": {
        "anthropic/claude-opus-5": {}
      }
    },
    "entries": {
      "main": {
        "name": "main",
        "workspace": "${HOME}/.openclaw/workspace",
        "agentDir": "${HOME}/.openclaw/agents/main/agent",
        "identity": {
          "name": "main"
        }
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "stub-gateway-token-not-a-secret"
    },
    "port": ${port},
    "bind": "${bind}",
    "tailscale": {
      "mode": "off"
    }
  },
  "tools": {
    "profile": "coding"
  },
  "plugins": {
    "entries": {
      "anthropic": {
        "enabled": true
      }
    }
  },
  "auth": {
    "profiles": {
      "anthropic:default": {
        "provider": "anthropic",
        "mode": "api_key"
      }
    }
  }
}
SEED

  cp "$config_path" "$seed_path"
  printf 'stub-openclaw: onboarded, wrote %s\n' "$config_path"
}

automation_id() {
  printf 'stub-job-%s' "$1"
}

automation_field() {
  local field value
  while IFS='=' read -r field value; do
    if [ "$field" = "$2" ]; then
      printf '%s' "$value"
      return 0
    fi
  done < "${automations_dir}/$1"
}

automation_json() {
  local name="$1" key
  key="$(automation_field "$name" declarationKey)"
  printf '{"id":"%s","name":"%s",' "$(automation_id "$name")" "$name"
  if [ -n "$key" ]; then
    printf '"declarationKey":"%s",' "$key"
  fi
  printf '"enabled":%s,"schedule":"stub"}' "$(automation_field "$name" enabled)"
}

cmd_automations_list() {
  local all='no' json='no' path name first='yes'
  local -a names=()

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --all) all='yes' ;;
      --json) json='yes' ;;
      *) unimplemented "automations list $*" ;;
    esac
    shift
  done

  for path in "${automations_dir}"/*; do
    if [ -e "$path" ]; then
      name="${path##*/}"
      if [ "$all" = 'yes' ] || [ "$(automation_field "$name" enabled)" != 'false' ]; then
        names+=("$name")
      fi
    fi
  done

  if [ "$json" = 'yes' ]; then
    printf '{"jobs":['
    for name in "${names[@]}"; do
      if [ "$first" = 'no' ]; then
        printf ','
      fi
      first='no'
      automation_json "$name"
    done
    printf '],"total":%d,"offset":0,"limit":200,"hasMore":false,"nextOffset":null}\n' "${#names[@]}"
    return 0
  fi

  if [ "${#names[@]}" -eq 0 ]; then
    printf 'No automations registered.\n'
    return 0
  fi
  for name in "${names[@]}"; do
    printf '%s  %s\n' "$(automation_id "$name")" "$name"
  done
}

cmd_automations_create() {
  local name='' key='' enabled='true' existing_key

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --name) name="${2:-}" ;;
      --declaration-key) key="${2:-}" ;;
      --disabled) enabled='false' ;;
    esac
    shift
  done

  if [ -z "$name" ]; then
    unimplemented 'automations create with no --name'
  fi
  case "$name" in
    */*|.|..|*'"'*|*\\*) unimplemented "automations create with unusable --name '${name}'" ;;
  esac
  case "$key" in
    *'"'*|*\\*) unimplemented "automations create with unusable --declaration-key '${key}'" ;;
  esac

  mkdir -p "$automations_dir"
  if [ -e "${automations_dir}/${name}" ]; then
    existing_key="$(automation_field "$name" declarationKey)"
    if [ -n "$key" ] && [ "$key" = "$existing_key" ]; then
      printf '{"created":false,"updated":false,"job":%s}\n' "$(automation_json "$name")"
      return 0
    fi
    unimplemented "automations create of a second job named '${name}'"
  fi

  {
    if [ -n "$key" ]; then
      printf 'declarationKey=%s\n' "$key"
    fi
    printf 'enabled=%s\n' "$enabled"
  } > "${automations_dir}/${name}"

  if [ -n "$key" ]; then
    printf '{"created":true,"job":%s}\n' "$(automation_json "$name")"
  else
    printf '%s\n' "$(automation_json "$name")"
  fi
}

cmd_automations() {
  local sub="${1:-}"
  if [ "$#" -gt 0 ]; then
    shift
  fi

  case "$sub" in
    list) cmd_automations_list "$@" ;;
    create) cmd_automations_create "$@" ;;
    *) unimplemented "automations ${sub}" ;;
  esac
}

cmd_gateway() {
  case "${1:-}" in
    health)
      printf 'stub-openclaw: gateway healthy\n'
      ;;
    ''|-*)
      printf 'stub-openclaw: gateway started and exiting (stub)\n'
      ;;
    *)
      unimplemented "gateway ${1}"
      ;;
  esac
}

cmd_config_set() {
  local path="${1:-}" value="${2:-}"
  if [ -z "$path" ] || [ -z "$value" ]; then
    unimplemented "config set (missing path or value)"
  fi
  shift 2
  local expect_absent='no' arg
  for arg in "$@"; do
    case "$arg" in
      --expect-current-absent) expect_absent='yes' ;;
      *) unimplemented "config set ${arg}" ;;
    esac
  done
  if [ "$expect_absent" != 'yes' ]; then
    unimplemented "config set (without --expect-current-absent)"
  fi

  STUB_CONFIG="$config_path" STUB_PATH="$path" STUB_VALUE="$value" node -e "
    const fs = require('fs');
    const configPath = process.env.STUB_CONFIG;
    let config = {};
    try {
      config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
    } catch {}
    const parts = process.env.STUB_PATH.split('.');
    let node = config;
    for (const key of parts.slice(0, -1)) {
      if (node[key] === null || typeof node[key] !== 'object') node[key] = {};
      node = node[key];
    }
    const leaf = parts[parts.length - 1];
    if (Object.prototype.hasOwnProperty.call(node, leaf)) {
      console.error('conditional config set expectation did not match the ' +
        'authored config, so nothing was changed');
      process.exit(1);
    }
    node[leaf] = process.env.STUB_VALUE;
    fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
  "
}

cmd_config_patch() {
  local stdin_only='no'
  local arg
  for arg in "$@"; do
    case "$arg" in
      --stdin) stdin_only='yes' ;;
      *) unimplemented "config patch ${arg}" ;;
    esac
  done
  if [ "$stdin_only" != 'yes' ]; then
    unimplemented "config patch (without --stdin)"
  fi

  STUB_CONFIG="$config_path" node -e "
    const fs = require('fs');
    const configPath = process.env.STUB_CONFIG;

    let patch;
    try {
      patch = JSON.parse(fs.readFileSync(0, 'utf8'));
    } catch (error) {
      console.error('stub-openclaw: config patch got a malformed document: ' +
        error.message);
      process.exit(1);
    }
    if (patch === null || typeof patch !== 'object' || Array.isArray(patch)) {
      console.error('stub-openclaw: config patch expects a JSON object');
      process.exit(1);
    }

    let config = {};
    try {
      config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
    } catch {}

    const isPlainObject = (value) =>
      value !== null && typeof value === 'object' && !Array.isArray(value);

    const merge = (target, source) => {
      for (const [key, value] of Object.entries(source)) {
        if (value === null) {
          delete target[key];
        } else if (isPlainObject(value) && isPlainObject(target[key])) {
          merge(target[key], value);
        } else if (isPlainObject(value)) {
          target[key] = merge({}, value);
        } else {
          target[key] = value;
        }
      }
      return target;
    };

    merge(config, patch);
    fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
  "
}

log_invocation "$@"

command="${1:-}"
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command" in
  onboard) cmd_onboard "$@" ;;
  config)
    sub="${1:-}"
    if [ "$#" -gt 0 ]; then
      shift
    fi
    case "$sub" in
      patch) cmd_config_patch "$@" ;;
      set) cmd_config_set "$@" ;;
      validate) printf 'stub-openclaw: config validate is not judged here\n' ;;
      *) unimplemented "config ${sub}" ;;
    esac
    ;;
  gateway) cmd_gateway "$@" ;;
  automations|cron) cmd_automations "$@" ;;
  *) unimplemented "$command" ;;
esac
