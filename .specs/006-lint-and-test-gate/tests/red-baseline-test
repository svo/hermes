#!/usr/bin/env bash
#
# PLAN.md task 1: "confirm it fails on current main for the five known
# findings. **The gate must be seen to fail before it is trusted.**"
#
# A gate that has only ever passed is indistinguishable from one that checks
# nothing — which is exactly how bin/test came to be missing for as long as it
# was. So this file makes the gate go red on a defect that was really in this
# repository, and then green on the fix.
#
# THE BASELINE COMES FROM HISTORY, NOT FROM THE WORKING TREE, and that is not
# a shortcut. PLAN task 1 was written when the five findings were still live;
# 005 has since landed and fixed them (commit 6e8932a). Writing five fresh
# violations by hand would prove only that shellcheck reports what a case just
# planted. Taking the actual pre-005 `hermes-check` out of git and running the
# real gate over it proves the thing task 1 asked for: this gate, unmodified,
# rejects the code that shipped.
#
# The one thing it cannot survive is a checkout with no history — a shallow CI
# clone has no object for the parent commit. That case is announced as a skip
# rather than passed over, because a red baseline nobody ran is worth exactly
# as much as a gate nobody ran.

set -uo pipefail

# shellcheck source-path=SCRIPTDIR
# shellcheck source=harness.sh
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/harness.sh"

require_bin_test

if ! command -v shellcheck >/dev/null 2>&1; then
  printf 'SKIP red-baseline-test: shellcheck is not installed\n' >&2
  exit 0
fi

# The commit that fixed the five findings. Its parent is the last tree in which
# they were live. Named rather than derived from `git log -1` on the path, so
# that a later commit touching hermes-check cannot silently move the baseline
# to a different file.
readonly FIX_COMMIT='6e8932a'
readonly HERMES_CHECK_PATH='infrastructure/ansible/roles/openclaw/files/hermes-check'

# SPEC finding E4. Two SC2086 (an unquoted account flag) and three SC2106
# (`continue` inside a command substitution, which is C4 — shellcheck had been
# reporting a real defect for as long as the file existed).
readonly EXPECTED_FINDINGS=5
readonly EXPECTED_SC2086=2
readonly EXPECTED_SC2106=3

BASELINE_FILE="${TMP_ROOT}/hermes-check-pre-005"
BASELINE_REASON=""

# The three ways this can be unavailable are distinguished rather than lumped
# together, because they need different fixes and the wrong reason sends a
# reader after the wrong one. "A shallow clone?" was reported for a checkout
# with complete history, when the real cause was git refusing a repository
# whose files belong to another user — the shape CI takes, where the runner
# owns the checkout and the container runs as root. Someone would have spent
# the afternoon on fetch-depth.
if ! command -v git >/dev/null 2>&1; then
  BASELINE_REASON='git is not installed'
elif ! git -C "$REPO_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
  # Captured, then matched. `git ... | grep -q` would be the obvious spelling
  # and would be wrong here: under `pipefail` the pipeline reports git's 128
  # rather than grep's 0, so the branch that recognises the message could never
  # be taken. That is the same class of defect as the `curl | tar` this spec's
  # ansible fixes deleted, which is a good enough reason to spell it out.
  git_error="$(git -C "$REPO_ROOT" rev-parse --git-dir 2>&1)" || true
  case "$git_error" in
    *'dubious ownership'*)
      BASELINE_REASON="git refuses ${REPO_ROOT}: dubious ownership. Set safe.directory (see .github/workflows/lint.yml)"
      ;;
    *)
      BASELINE_REASON="${REPO_ROOT} is not a readable git repository"
      ;;
  esac
elif ! git -C "$REPO_ROOT" rev-parse --verify --quiet "${FIX_COMMIT}^{commit}" >/dev/null 2>&1; then
  BASELINE_REASON="commit ${FIX_COMMIT} is not in this checkout (a shallow clone? try fetch-depth: 0)"
elif ! git -C "$REPO_ROOT" show "${FIX_COMMIT}^:${HERMES_CHECK_PATH}" \
  > "$BASELINE_FILE" 2>/dev/null; then
  BASELINE_REASON="${FIX_COMMIT}^:${HERMES_CHECK_PATH} could not be read"
fi

baseline_available() {
  [ -z "$BASELINE_REASON" ]
}

# One gate run over a tree carrying the pre-005 file, shared by the cases that
# ask different questions about it.
RED_OUT=""
RED_STATUS=0
if baseline_available; then
  RED_SANDBOX="$(make_sandbox)"
  cat "$BASELINE_FILE" > "${RED_SANDBOX}/${HERMES_CHECK_PATH}"
  run_gate --dir "$RED_SANDBOX"
  RED_OUT="$GATE_OUT"
  RED_STATUS="$GATE_STATUS"
fi

should_report_five_findings_when_shellcheck_reads_the_pre_005_script() {
  case_start "${FUNCNAME[0]}"
  if ! baseline_available; then
    skip_case "${FUNCNAME[0]}" "$BASELINE_REASON"
    return
  fi
  # `-f gcc` here, and only here: this case counts findings, and one line per
  # finding is the format that makes counting honest. The gate itself is left
  # to choose its own format, and the cases that read its output count rule
  # codes instead.
  local out
  out="$(shellcheck -s bash -f gcc "$BASELINE_FILE" 2>&1 || true)"
  assert_equals "findings in the pre-005 script" "$EXPECTED_FINDINGS" \
    "$(count_matching_lines "$out" '^')"
  assert_equals "SC2086 findings" "$EXPECTED_SC2086" \
    "$(count_matching_lines "$out" 'SC2086')"
  assert_equals "SC2106 findings" "$EXPECTED_SC2106" \
    "$(count_matching_lines "$out" 'SC2106')"
  case_end
}

should_fail_when_the_gate_runs_over_the_pre_005_script() {
  case_start "${FUNCNAME[0]}"
  if ! baseline_available; then
    skip_case "${FUNCNAME[0]}" "$BASELINE_REASON"
    return
  fi
  GATE_OUT="$RED_OUT"
  assert_equals "shellcheck check result" "FAIL" "$(gate_result shellcheck)"
  if [ "$RED_STATUS" -eq 0 ]; then
    fail "the gate exited zero over the tree that shipped five findings"
  fi
  case_end
}

should_name_the_offending_file_when_the_gate_fails() {
  case_start "${FUNCNAME[0]}"
  if ! baseline_available; then
    skip_case "${FUNCNAME[0]}" "$BASELINE_REASON"
    return
  fi
  # Naming the check is not enough to act on. SPEC AC 2 asks for the failing
  # check; an operator also needs the file, and the reviewer who filed E4
  # needed the rule codes.
  assert_contains "the gate names hermes-check" "$RED_OUT" "$HERMES_CHECK_PATH"
  assert_contains "and the unquoted-expansion rule" "$RED_OUT" "SC2086"
  assert_contains "and the misplaced-continue rule" "$RED_OUT" "SC2106"
  case_end
}

should_fail_no_other_check_when_only_the_old_script_is_restored() {
  case_start "${FUNCNAME[0]}"
  if ! baseline_available; then
    skip_case "${FUNCNAME[0]}" "$BASELINE_REASON"
    return
  fi
  # A red baseline is only evidence if it is attributable. If restoring one
  # file turned three checks red, the run would prove that the sandbox is
  # broken rather than that the gate found E4.
  assert_equals "failing checks" "1" \
    "$(count_matching_lines "$RED_OUT" '^FAIL ')"
  case_end
}

should_pass_when_the_gate_runs_over_the_current_script() {
  case_start "${FUNCNAME[0]}"
  # The green half. Same gate, same tree, one file different — so the red
  # above is a statement about that file and not about the gate's mood.
  local sandbox
  sandbox="$(make_sandbox)"
  run_gate --dir "$sandbox"
  assert_equals "shellcheck check result" "PASS" "$(gate_result shellcheck)"
  assert_equals "exit status" "0" "$GATE_STATUS"
  case_end
}

should_report_five_findings_when_shellcheck_reads_the_pre_005_script
should_fail_when_the_gate_runs_over_the_pre_005_script
should_name_the_offending_file_when_the_gate_fails
should_fail_no_other_check_when_only_the_old_script_is_restored
should_pass_when_the_gate_runs_over_the_current_script

report_totals "red-baseline-test"
