#!/usr/bin/env bash

set -uo pipefail

config="${HOME}/.openclaw/openclaw.json"
store="${OPENCLAW_STUB_STORE:-}"
markers="${OPENCLAW_STUB_MARKERS:-}"

usage() {
  printf 'stub-openclaw: unsupported invocation: %s\n' "$*" >&2
  exit 64
}

argv_json() {
  printf '%s\0' "$@" | node -e "
    let raw = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (chunk) => { raw += chunk; });
    process.stdin.on('end', () => {
      const parts = raw.split('\0');
      parts.pop();
      process.stdout.write(JSON.stringify(parts));
    });
  "
}

record() {
  [ -n "$markers" ] || return 0
  printf '%s\n' "$2" >> "${markers}/calls-$1"
  printf '%s %s\n' "$1" "$2" >> "${markers}/call-order"
}

refuse() {
  STUB_REASON="$1" node -e "
    const reason = process.env.STUB_REASON;
    console.log(JSON.stringify({ ok: false, error: { type: 'cli_error', message: reason } }, null, 2));
  "
  printf '%s\n' \
    '[openclaw] Could not start the CLI.' \
    "[openclaw] Reason: $1" \
    '[openclaw] Debug: set OPENCLAW_DEBUG=1 to include the stack trace.' \
    '[openclaw] Try: openclaw doctor' \
    '[openclaw] Help: openclaw --help' >&2
  exit 1
}

agent_warning='No --agent specified; the job will run with the configured default agent. Specify --agent to choose a specific agent, or set agents.defaults.systemAgent.agentId.'

case "${1:-}" in
  onboard)
    mkdir -p "$(dirname "$config")"
    cat > "$config" <<'ONBOARDED'
{
  "gateway": {
    "port": 3000,
    "bind": "lan"
  },
  "agents": {
    "defaults": {}
  },
  "tools": {},
  "channels": {},
  "env": {}
}
ONBOARDED
    exit 0
    ;;

  gateway)
    case "${2:-}" in
      health)
        if [ -n "$markers" ]; then
          printf '%s\n' "$*" >> "${markers}/calls-health"
        fi
        [ "${OPENCLAW_STUB_HANG:-no}" = "health" ] && exec sleep 3600
        [ "${OPENCLAW_STUB_GATEWAY_READY:-yes}" = "yes" ] || exit 1
        printf 'ok\n'
        exit 0
        ;;
      *)
        if [ -n "$markers" ]; then
          : > "${markers}/gateway-started"
          if [ -n "${GOG_ACCOUNT+set}" ]; then
            printf '%s' "$GOG_ACCOUNT" > "${markers}/gateway-gog-account"
          fi
        fi
        exit 0
        ;;
    esac
    ;;

  config)
    case "${2:-}" in
      set)
        stub_path="${3:-}"
        stub_value="${4:-}"
        if [ -z "$stub_path" ] || [ -z "$stub_value" ]; then usage "$@"; fi
        shift 4
        stub_expect_absent='no'
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --expect-current-absent) stub_expect_absent='yes' ;;
            *) usage "config set $*" ;;
          esac
          shift
        done
        [ "$stub_expect_absent" = 'yes' ] || usage 'config set (without --expect-current-absent)'

        STUB_CONFIG="$config" STUB_PATH="$stub_path" STUB_VALUE="$stub_value" node -e "
          const fs = require('fs');
          const configPath = process.env.STUB_CONFIG;
          let config = {};
          try {
            config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
          } catch {}

          const parts = process.env.STUB_PATH.split('.');
          let node = config;
          for (const key of parts.slice(0, -1)) {
            if (node[key] === null || typeof node[key] !== 'object') node[key] = {};
            node = node[key];
          }
          const leaf = parts[parts.length - 1];
          if (Object.prototype.hasOwnProperty.call(node, leaf)) {
            console.error('conditional config set expectation did not match the ' +
              'authored config, so nothing was changed');
            process.exit(1);
          }
          node[leaf] = process.env.STUB_VALUE;
          fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
        "
        exit $?
        ;;

      patch)
        if [ -n "${OPENCLAW_STUB_PATCH_ERROR:-}" ]; then
          printf '%s\n' "$OPENCLAW_STUB_PATCH_ERROR" >&2
          exit 1
        fi
        shift 2
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --stdin) ;;
            *) usage "config patch $*" ;;
          esac
          shift
        done

        STUB_CONFIG="$config" node -e "
          const fs = require('fs');
          const configPath = process.env.STUB_CONFIG;

          let patch;
          try {
            patch = JSON.parse(fs.readFileSync(0, 'utf8'));
          } catch (error) {
            console.error('stub-openclaw: config patch got a malformed document: ' +
              error.message);
            process.exit(1);
          }
          if (patch === null || typeof patch !== 'object' || Array.isArray(patch)) {
            console.error('stub-openclaw: config patch expects a JSON object');
            process.exit(1);
          }

          let config = {};
          try {
            config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
          } catch {}

          const isPlainObject = (value) =>
            value !== null && typeof value === 'object' && !Array.isArray(value);

          const merge = (target, source) => {
            for (const [key, value] of Object.entries(source)) {
              if (value === null) {
                delete target[key];
              } else if (isPlainObject(value) && isPlainObject(target[key])) {
                merge(target[key], value);
              } else if (isPlainObject(value)) {
                target[key] = merge({}, value);
              } else {
                target[key] = value;
              }
            }
            return target;
          };

          merge(config, patch);
          fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
        "
        exit $?
        ;;

      validate)
        if [ -n "$markers" ]; then
          : > "${markers}/config-validated"
        fi
        printf 'ok\n'
        exit 0
        ;;
      *)
        usage "$@"
        ;;
    esac
    ;;

  automations | cron)
    verb="${2:-}"
    shift 2 2>/dev/null || usage "$@"
    argv="$(argv_json "$@")"
    record "$verb" "$argv"

    case "$verb" in
      list)
        [ "${OPENCLAW_STUB_LIST_FAILS:-no}" = "no" ] || {
          printf 'stub-openclaw: gateway refused: operator.admin required\n' >&2
          exit 1
        }
        STUB_ARGV="$argv" STUB_STORE="$store" \
        STUB_LIST_JSON="${OPENCLAW_STUB_LIST_JSON:-yes}" \
        STUB_LIST_SHAPE="${OPENCLAW_STUB_LIST_SHAPE:-envelope}" node -e "
          const fs = require('fs');
          const argv = JSON.parse(process.env.STUB_ARGV);

          let all = false;
          let json = false;
          for (const arg of argv) {
            if (arg === '--all') { all = true; continue; }
            if (arg === '--json') {
              if (process.env.STUB_LIST_JSON !== 'yes') {
                console.error('stub-openclaw: unknown option --json');
                process.exit(64);
              }
              json = true;
              continue;
            }
            console.error('stub-openclaw: unknown list flag: ' + arg);
            process.exit(64);
          }

          const stored = JSON.parse(fs.readFileSync(process.env.STUB_STORE + '/jobs.json', 'utf8'));
          const jobs = all ? stored : stored.filter((job) => job.enabled !== false);

          if (json === false) {
            for (const job of jobs) console.log(job.id + '  ' + job.name + '  ' + job.schedule);
            process.exit(0);
          }

          const envelope = (rows) => ({
            jobs: rows, total: rows.length, offset: 0, limit: 200, hasMore: false, nextOffset: null
          });
          const print = (value) => console.log(JSON.stringify(value, null, 2));

          switch (process.env.STUB_LIST_SHAPE) {
            case 'envelope':
              print(envelope(jobs));
              break;
            case 'bare':
              print(jobs);
              break;
            case 'garbage':
              process.stdout.write('not json at all\n');
              break;
            case 'renamed':
              print(envelope(jobs.map((job) => ({ automationId: job.id, automationName: job.name }))));
              break;
            default:
              console.error('stub-openclaw: unknown OPENCLAW_STUB_LIST_SHAPE: ' + process.env.STUB_LIST_SHAPE);
              process.exit(64);
          }
        "
        exit $?
        ;;

      create)
        if [ "${OPENCLAW_STUB_CREATE_FAILS:-no}" = "yes" ]; then
          printf '%s\n' "$agent_warning" >&2
          refuse "stub-openclaw: ${OPENCLAW_STUB_CREATE_ERROR:-gateway refused: operator.admin required}"
        fi
        case "${OPENCLAW_STUB_CREATE_OUTPUT:-json}" in
          json | garbage) ;;
          *) usage "OPENCLAW_STUB_CREATE_OUTPUT=${OPENCLAW_STUB_CREATE_OUTPUT}" ;;
        esac

        outcome="$(
          STUB_ARGV="$argv" STUB_STORE="$store" STUB_MARKERS="$markers" \
          STUB_CREATE_SILENT="${OPENCLAW_STUB_CREATE_SILENT:-no}" node -e "
            const fs = require('fs');
            const argv = JSON.parse(process.env.STUB_ARGV);

            const request = {
              name: null, tz: null, session: null,
              announce: false, channel: null, to: null
            };
            let declarationKey = null;
            let exact = false;
            let disabled = false;
            const positional = [];
            const takesValue = {
              '--name': 'name', '--tz': 'tz', '--session': 'session',
              '--channel': 'channel', '--to': 'to', '--declaration-key': 'declarationKey'
            };

            for (let i = 0; i < argv.length; i += 1) {
              const arg = argv[i];
              if (arg === '--announce') { request.announce = true; continue; }
              if (arg === '--exact') { exact = true; continue; }
              if (arg === '--disabled') { disabled = true; continue; }
              if (Object.prototype.hasOwnProperty.call(takesValue, arg)) {
                i += 1;
                if (i >= argv.length) {
                  console.error('stub-openclaw: ' + arg + ' needs a value');
                  process.exit(64);
                }
                if (arg === '--declaration-key') {
                  declarationKey = argv[i].trim() || null;
                } else {
                  request[takesValue[arg]] = argv[i];
                }
                continue;
              }
              if (arg.startsWith('--')) {
                console.error('stub-openclaw: unknown create flag: ' + arg);
                process.exit(64);
              }
              positional.push(arg);
            }

            if (positional.length !== 2) {
              console.error('stub-openclaw: create takes a schedule and a prompt, got ' + positional.length);
              process.exit(64);
            }
            request.schedule = positional[0];
            request.prompt = positional[1];
            if (exact) request.staggerMs = 0;

            const refuse = (reason) => {
              process.stdout.write(reason);
              process.exit(3);
            };

            const reserved = ['heartbeat-task:', 'skill-collection-review:']
              .find((prefix) => declarationKey !== null && declarationKey.startsWith(prefix));
            if (reserved) {
              refuse('invalid cron.add params: cron declarationKey namespace \"' + reserved +
                '\" is system-owned; jobs cannot be created with it');
            }

            const storeDir = process.env.STUB_STORE;
            const storePath = storeDir + '/jobs.json';
            const jobs = JSON.parse(fs.readFileSync(storePath, 'utf8'));
            const emit = (value) => process.stdout.write(JSON.stringify(value, null, 2));

            const nextId = () => {
              const counterPath = storeDir + '/next-id';
              let last = 0;
              try { last = Number(fs.readFileSync(counterPath, 'utf8')) || 0; } catch {}
              for (const job of jobs) {
                const match = /^job-([0-9]+)\$/.exec(String(job.id));
                if (match) last = Math.max(last, Number(match[1]));
              }
              fs.writeFileSync(counterPath, String(last + 1) + '\n');
              return 'job-' + String(last + 1).padStart(4, '0');
            };
            const write = (kind, id) => {
              fs.writeFileSync(storePath, JSON.stringify(jobs, null, 2) + '\n');
              fs.appendFileSync(storeDir + '/writes', kind + ' ' + id + '\n');
            };
            const fresh = () => Object.assign(
              { id: nextId() },
              declarationKey === null ? {} : { declarationKey },
              request,
              { enabled: disabled === false }
            );

            const matches = declarationKey === null
              ? []
              : jobs.filter((job) => job.declarationKey === declarationKey);
            if (matches.length > 1) {
              refuse('cron declarationKey is ambiguous within caller scope: ' + declarationKey);
            }

            if (process.env.STUB_CREATE_SILENT === 'yes') {
              const job = fresh();
              emit(declarationKey === null ? job : { created: true, job });
              process.exit(0);
            }

            if (matches.length === 0) {
              const job = fresh();
              jobs.push(job);
              write('create', job.id);
              emit(declarationKey === null ? job : { created: true, job });
              process.exit(0);
            }

            const existing = matches[0];
            const next = Object.assign({}, existing);
            for (const field of ['schedule', 'tz', 'prompt', 'announce', 'channel', 'to']) {
              next[field] = request[field];
            }
            const sameExpression = existing.schedule === request.schedule;
            if (exact) {
              next.staggerMs = 0;
            } else if (sameExpression && Object.prototype.hasOwnProperty.call(existing, 'staggerMs')) {
              next.staggerMs = existing.staggerMs;
            } else {
              delete next.staggerMs;
            }
            if (disabled) next.enabled = false;

            const fields = new Set([...Object.keys(existing), ...Object.keys(next)]);
            const differs = [...fields].some(
              (field) => JSON.stringify(existing[field]) !== JSON.stringify(next[field])
            );

            const settledPath = process.env.STUB_MARKERS
              ? process.env.STUB_MARKERS + '/settled-' + existing.id
              : null;
            const settled = settledPath !== null && fs.existsSync(settledPath);
            const staggerless = exact === false && sameExpression &&
              Object.prototype.hasOwnProperty.call(existing, 'staggerMs') === false;
            const settle = () => { if (settledPath !== null) fs.writeFileSync(settledPath, ''); };

            if (differs) {
              jobs[jobs.indexOf(existing)] = next;
              write('update', next.id);
              if (staggerless) settle();
              emit({ created: false, updated: true, job: next });
            } else if (staggerless && settled === false) {
              write('settle', next.id);
              settle();
              emit({ created: false, updated: true, job: next });
            } else {
              emit({ created: false, updated: false, job: existing });
            }
          "
        )"
        status=$?
        case "$status" in
          0 | 3) printf '%s\n' "$agent_warning" >&2 ;;
          *) exit "$status" ;;
        esac
        [ "$status" -eq 0 ] || refuse "$outcome"
        if [ "${OPENCLAW_STUB_CREATE_OUTPUT:-json}" = "garbage" ]; then
          printf 'not json at all\n'
        else
          printf '%s\n' "$outcome"
        fi
        exit 0
        ;;

      remove)
        outcome="$(
          STUB_ARGV="$argv" STUB_STORE="$store" \
          STUB_REMOVE_FAILS="${OPENCLAW_STUB_REMOVE_FAILS:-no}" node -e "
            const fs = require('fs');
            const argv = JSON.parse(process.env.STUB_ARGV);

            for (const arg of argv) {
              if (arg.startsWith('-')) {
                console.error('stub-openclaw: unknown remove flag: ' + arg);
                process.exit(64);
              }
            }
            if (argv.length !== 1) {
              console.error('stub-openclaw: remove takes one id, got ' + argv.length);
              process.exit(64);
            }

            const refuse = (reason) => {
              process.stdout.write(reason);
              process.exit(3);
            };
            if (process.env.STUB_REMOVE_FAILS === 'yes') {
              refuse('stub-openclaw: gateway refused: operator.admin required');
            }

            const id = argv[0];
            const storeDir = process.env.STUB_STORE;
            const storePath = storeDir + '/jobs.json';
            const jobs = JSON.parse(fs.readFileSync(storePath, 'utf8'));
            const index = jobs.findIndex((job) => job.id === id);
            if (index === -1) {
              const tick = String.fromCharCode(96);
              refuse('Automation not found: ' + id + '. Run ' + tick + 'openclaw cron list' + tick +
                ' to see recent automation ids.');
            }
            jobs.splice(index, 1);
            fs.writeFileSync(storePath, JSON.stringify(jobs, null, 2) + '\n');
            fs.appendFileSync(storeDir + '/writes', 'remove ' + id + '\n');
            process.stdout.write(JSON.stringify({ ok: true, removed: true }, null, 2));
          "
        )"
        status=$?
        case "$status" in
          0) printf '%s\n' "$outcome"; exit 0 ;;
          3) refuse "$outcome" ;;
          *) exit "$status" ;;
        esac
        ;;

      *)
        usage "$@"
        ;;
    esac
    ;;

  *)
    usage "$@"
    ;;
esac
