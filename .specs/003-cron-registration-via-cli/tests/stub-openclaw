#!/usr/bin/env bash
#
# Fake `openclaw`, standing in for the subcommands the entrypoint and these
# cases use. No network, no credentials, no image.
#
#   onboard             writes the minimal config real onboarding leaves behind
#   gateway             records that it was reached, then exits 0 instead of serving
#   gateway health      the readiness probe the registrar polls
#   config validate     the startup gate 004 added; accepts, and records the call
#   automations list    reads the stub's automation store
#   automations create  appends to it, rejecting flags it does not know
#
# The store is a JSON array in $OPENCLAW_STUB_STORE/jobs.json, so a case can
# point several runs at the same store and ask what five restarts left behind.
#
# `create` rejecting an unknown flag is deliberate. The upstream docs do not
# publish a complete flag list for it, so the registrar must not invent one —
# a speculative --json or --deliver has to fail here the way it would fail
# against the real binary, rather than being quietly accepted.
#
# Behaviour switches, all defaulting to the happy path:
#
#   OPENCLAW_STUB_GATEWAY_READY  no    -> `gateway health` never succeeds
#   OPENCLAW_STUB_CREATE_FAILS   yes   -> `automations create` exits 1
#   OPENCLAW_STUB_CREATE_ERROR   text  -> what it says when it does
#   OPENCLAW_STUB_CREATE_SILENT  yes   -> create exits 0 but stores nothing
#   OPENCLAW_STUB_LIST_JSON      no    -> `list --json` is rejected as unknown
#   OPENCLAW_STUB_LIST_SHAPE     wrapped|garbage|renamed -> a different --json envelope
#   OPENCLAW_STUB_LIST_FAILS     yes   -> `list` exits 1 whatever the flags
#   OPENCLAW_STUB_HANG           health -> that call blocks instead of answering

set -uo pipefail

config="${HOME}/.openclaw/openclaw.json"
store="${OPENCLAW_STUB_STORE:-}"
markers="${OPENCLAW_STUB_MARKERS:-}"

usage() {
  printf 'stub-openclaw: unsupported invocation: %s\n' "$*" >&2
  exit 64
}

# argv as a JSON array, so an argument holding newlines still records as one
# line and one element.
argv_json() {
  printf '%s\0' "$@" | node -e "
    let raw = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (chunk) => { raw += chunk; });
    process.stdin.on('end', () => {
      const parts = raw.split('\0');
      parts.pop();
      process.stdout.write(JSON.stringify(parts));
    });
  "
}

record() {
  # record <verb> <json-argv>
  [ -n "$markers" ] || return 0
  printf '%s\n' "$2" >> "${markers}/calls-$1"
}

case "${1:-}" in
  onboard)
    mkdir -p "$(dirname "$config")"
    cat > "$config" <<'ONBOARDED'
{
  "gateway": {
    "port": 3000,
    "bind": "lan"
  },
  "agents": {
    "defaults": {}
  },
  "tools": {},
  "channels": {},
  "env": {}
}
ONBOARDED
    exit 0
    ;;

  gateway)
    case "${2:-}" in
      health)
        if [ -n "$markers" ]; then
          printf '%s\n' "$*" >> "${markers}/calls-health"
        fi
        # A gateway that accepts the connection and then never answers. Only a
        # timeout bounds this; a retry budget alone would wait forever.
        [ "${OPENCLAW_STUB_HANG:-no}" = "health" ] && exec sleep 3600
        [ "${OPENCLAW_STUB_GATEWAY_READY:-yes}" = "yes" ] || exit 1
        printf 'ok\n'
        exit 0
        ;;
      *)
        # `exec openclaw gateway` is the last line of the entrypoint, so this
        # marker is how a case asserts that a rejected configuration never got
        # that far — and that a failed registration did not stop it.
        if [ -n "$markers" ]; then
          : > "${markers}/gateway-started"
        fi
        exit 0
        ;;
    esac
    ;;

  config)
    # 004 gates startup on this before forking the registrar. Nothing here is
    # about validation, so it accepts — 004's own stub carries the schema
    # transcription that can reject. The marker lets a case assert the gate ran
    # ahead of the fork.
    case "${2:-}" in
      set)
        # Write-if-absent, which is the only shape the entrypoint uses. 008 sets
        # tools.exec.security this way so that a restart cannot revert an
        # operator's tightened exec policy -- 004's finding B6, which used to be
        # held by the `[ ! -f ]` guard on exec-approvals.json.
        #
        # Strict about the flag for the same reason 008's `config patch` is: a
        # stub that ignored --expect-current-absent would perform an
        # unconditional write and turn the case that pins this green.
        stub_path="${3:-}"
        stub_value="${4:-}"
        if [ -z "$stub_path" ] || [ -z "$stub_value" ]; then usage "$@"; fi
        shift 4
        stub_expect_absent='no'
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --expect-current-absent) stub_expect_absent='yes' ;;
            *) usage "config set $*" ;;
          esac
          shift
        done
        [ "$stub_expect_absent" = 'yes' ] || usage 'config set (without --expect-current-absent)'

        STUB_CONFIG="$config" STUB_PATH="$stub_path" STUB_VALUE="$stub_value" node -e "
          const fs = require('fs');
          const configPath = process.env.STUB_CONFIG;
          let config = {};
          try {
            config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
          } catch {}

          const parts = process.env.STUB_PATH.split('.');
          let node = config;
          for (const key of parts.slice(0, -1)) {
            if (node[key] === null || typeof node[key] !== 'object') node[key] = {};
            node = node[key];
          }
          const leaf = parts[parts.length - 1];
          if (Object.prototype.hasOwnProperty.call(node, leaf)) {
            // The refusal upstream gives, and the exit code the entrypoint reads.
            console.error('conditional config set expectation did not match the ' +
              'authored config, so nothing was changed');
            process.exit(1);
          }
          node[leaf] = process.env.STUB_VALUE;
          fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
        "
        exit $?
        ;;

      patch)
        # 008 routes the main config block through `openclaw config patch`
        # rather than letting the entrypoint open openclaw.json itself. The
        # merge is modelled here; the verdict is not.
        #
        # Upstream's contract, from `openclaw config patch --help`: objects
        # merge recursively, arrays and scalars replace, and null deletes a
        # path. The entrypoint emits strict JSON, which is the JSON5 subset the
        # real command accepts, so JSON.parse is enough and no JSON5 parser is
        # needed here.
        #
        # It validates nothing on purpose. A stub with a schema opinion would be
        # a third transcription to keep in step with upstream; 006's
        # config-schema-check runs the REAL validator over the file this
        # produces, which is the check that decides whether the payload is
        # legal. This decides only what the file looks like.
        #
        #   OPENCLAW_STUB_PATCH_ERROR  text -> `config patch` rejects with this
        #                              message and writes nothing, the way a
        #                              schema violation does. The entrypoint
        #                              redacts that message before it reaches
        #                              the log, so a case has to be able to make
        #                              it quote a credential.
        if [ -n "${OPENCLAW_STUB_PATCH_ERROR:-}" ]; then
          printf '%s\n' "$OPENCLAW_STUB_PATCH_ERROR" >&2
          exit 1
        fi
        # Strict about its flags, and that is load-bearing rather than tidy.
        # A stub that shrugged at an unrecognised flag let two real regressions
        # through 008's mutation check: `--dry-run` writes nothing at all, and
        # `--replace-path agents.defaults.models` restores the whole-object
        # clobber 008 exists to remove. Both produced a green run against a
        # permissive stub, because the merge it performed was its own rather
        # than the one it was asked for.
        shift 2
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --stdin) ;;
            *) usage "config patch $*" ;;
          esac
          shift
        done

        STUB_CONFIG="$config" node -e "
          const fs = require('fs');
          const configPath = process.env.STUB_CONFIG;

          let patch;
          try {
            patch = JSON.parse(fs.readFileSync(0, 'utf8'));
          } catch (error) {
            console.error('stub-openclaw: config patch got a malformed document: ' +
              error.message);
            process.exit(1);
          }
          if (patch === null || typeof patch !== 'object' || Array.isArray(patch)) {
            console.error('stub-openclaw: config patch expects a JSON object');
            process.exit(1);
          }

          let config = {};
          try {
            config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
          } catch {}

          // null deletes; a plain object merges into a plain object; anything
          // else — array, scalar, or an object landing on a non-object —
          // replaces. That is upstream's rule, restated.
          const isPlainObject = (value) =>
            value !== null && typeof value === 'object' && !Array.isArray(value);

          const merge = (target, source) => {
            for (const [key, value] of Object.entries(source)) {
              if (value === null) {
                delete target[key];
              } else if (isPlainObject(value) && isPlainObject(target[key])) {
                merge(target[key], value);
              } else if (isPlainObject(value)) {
                target[key] = merge({}, value);
              } else {
                target[key] = value;
              }
            }
            return target;
          };

          merge(config, patch);
          fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
        "
        exit $?
        ;;

      validate)
        if [ -n "$markers" ]; then
          : > "${markers}/config-validated"
        fi
        printf 'ok\n'
        exit 0
        ;;
      *)
        usage "$@"
        ;;
    esac
    ;;

  automations | cron)
    verb="${2:-}"
    shift 2 2>/dev/null || usage "$@"
    argv="$(argv_json "$@")"
    record "$verb" "$argv"

    case "$verb" in
      list)
        [ "${OPENCLAW_STUB_LIST_FAILS:-no}" = "no" ] || {
          printf 'stub-openclaw: gateway refused: operator.admin required\n' >&2
          exit 1
        }
        STUB_ARGV="$argv" STUB_STORE="$store" \
        STUB_LIST_JSON="${OPENCLAW_STUB_LIST_JSON:-yes}" \
        STUB_LIST_SHAPE="${OPENCLAW_STUB_LIST_SHAPE:-array}" node -e "
          const fs = require('fs');
          const argv = JSON.parse(process.env.STUB_ARGV);

          let all = false;
          let json = false;
          for (const arg of argv) {
            if (arg === '--all') { all = true; continue; }
            if (arg === '--json') {
              if (process.env.STUB_LIST_JSON !== 'yes') {
                console.error('stub-openclaw: unknown option --json');
                process.exit(64);
              }
              json = true;
              continue;
            }
            console.error('stub-openclaw: unknown list flag: ' + arg);
            process.exit(64);
          }

          const stored = JSON.parse(fs.readFileSync(process.env.STUB_STORE + '/jobs.json', 'utf8'));
          const jobs = all ? stored : stored.filter((job) => job.enabled !== false);

          if (json === false) {
            for (const job of jobs) console.log(job.id + '  ' + job.name + '  ' + job.schedule);
            process.exit(0);
          }
          if (process.env.STUB_LIST_SHAPE === 'garbage') {
            process.stdout.write('not json at all\n');
            process.exit(0);
          }
          if (process.env.STUB_LIST_SHAPE === 'wrapped') {
            console.log(JSON.stringify({ ok: true, jobs }, null, 2));
            process.exit(0);
          }
          // Valid JSON whose key names are none of the ones the registrar
          // guesses at. The plain listing below still prints the name, so this
          // is the case where the --json path must not be the last word.
          if (process.env.STUB_LIST_SHAPE === 'renamed') {
            console.log(JSON.stringify(
              jobs.map((job) => ({ automationId: job.id, automationName: job.name })),
              null,
              2
            ));
            process.exit(0);
          }
          console.log(JSON.stringify(jobs, null, 2));
        "
        exit $?
        ;;

      create)
        if [ "${OPENCLAW_STUB_CREATE_FAILS:-no}" = "yes" ]; then
          printf 'stub-openclaw: %s\n' \
            "${OPENCLAW_STUB_CREATE_ERROR:-gateway refused: operator.admin required}" >&2
          exit 1
        fi
        STUB_ARGV="$argv" STUB_STORE="$store" \
        STUB_CREATE_SILENT="${OPENCLAW_STUB_CREATE_SILENT:-no}" node -e "
          const fs = require('fs');
          const argv = JSON.parse(process.env.STUB_ARGV);

          const job = {
            name: null, tz: null, session: null,
            announce: false, channel: null, to: null
          };
          const positional = [];
          const takesValue = {
            '--name': 'name', '--tz': 'tz', '--session': 'session',
            '--channel': 'channel', '--to': 'to'
          };

          for (let i = 0; i < argv.length; i += 1) {
            const arg = argv[i];
            if (arg === '--announce') { job.announce = true; continue; }
            if (Object.prototype.hasOwnProperty.call(takesValue, arg)) {
              i += 1;
              if (i >= argv.length) {
                console.error('stub-openclaw: ' + arg + ' needs a value');
                process.exit(64);
              }
              job[takesValue[arg]] = argv[i];
              continue;
            }
            if (arg.startsWith('--')) {
              console.error('stub-openclaw: unknown create flag: ' + arg);
              process.exit(64);
            }
            positional.push(arg);
          }

          if (positional.length !== 2) {
            console.error('stub-openclaw: create takes a schedule and a prompt, got ' + positional.length);
            process.exit(64);
          }
          job.schedule = positional[0];
          job.prompt = positional[1];
          job.enabled = true;

          // A create that reports success and stores nothing. The registrar
          // must notice, because that is what an unrecorded failure looks like.
          if (process.env.STUB_CREATE_SILENT === 'yes') {
            console.log('Created automation ' + job.name);
            process.exit(0);
          }

          const storePath = process.env.STUB_STORE + '/jobs.json';
          const jobs = JSON.parse(fs.readFileSync(storePath, 'utf8'));
          job.id = 'job-' + String(jobs.length + 1).padStart(4, '0');
          jobs.push(job);
          fs.writeFileSync(storePath, JSON.stringify(jobs, null, 2) + '\n');
          console.log('Created automation ' + job.name);
        "
        exit $?
        ;;

      *)
        usage "$@"
        ;;
    esac
    ;;

  *)
    usage "$@"
    ;;
esac
