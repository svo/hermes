#!/usr/bin/env bash

set -uo pipefail
# shellcheck source=harness.sh
. "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/harness.sh"

BRIEFING='morning-briefing'
KEY='hermes:morning-briefing'

declared_key() {
  stub_calls create | head -n 1 | jq -r 'index("--declaration-key") as $i | if $i == null then "none" else .[$i + 1] end'
}

case_start "should_declare_the_briefing_under_the_hermes_key_when_the_store_is_empty"
run_entrypoint
assert_equals "briefings" "1" "$(store_count_named "$BRIEFING")"
assert_equals "the job carries the key" "$KEY" "$(store_job_field "$BRIEFING" '.declarationKey')"
assert_contains "it is logged as created" "$(run_log)" \
  "cron: registered ${BRIEFING} $(store_job_field "$BRIEFING" '.id')"
case_end

case_start "should_store_an_explicit_zero_stagger_when_the_briefing_is_declared"
run_entrypoint
assert_contains "create was passed --exact" "$(stub_calls create)" '"--exact"'
assert_equals "the stored stagger" "0" "$(store_job_field "$BRIEFING" '.staggerMs')"
case_end

case_start "should_write_nothing_when_five_restarts_change_nothing"
store="$(new_store)"
home="$(mktemp -d "${TMP_ROOT}/volume.XXXXXX")"
mkdir -p "${home}/.openclaw"
run_entrypoint --store "$store" --home "$home"
first_id="$(store_job_field "$BRIEFING" '.id')"
unchanged_starts=0
for _ in 1 2 3 4 5; do
  run_entrypoint --store "$store" --home "$home"
  case "$(run_log)" in
    *"cron: ${BRIEFING} unchanged (${first_id})"*) unchanged_starts=$((unchanged_starts + 1)) ;;
  esac
done
assert_equals "briefings after five restarts" "1" "$(store_count_named "$BRIEFING")"
assert_equals "the same job" "$first_id" "$(store_job_field "$BRIEFING" '.id')"
assert_equals "writes, all of them the first start's" "1" "$(store_write_count)"
assert_equals "restarts that logged unchanged" "5" "$unchanged_starts"
case_end

case_start "should_carry_the_new_schedule_on_the_same_job_when_the_schedule_changes"
store="$(new_store)"
run_entrypoint --store "$store"
first_id="$(store_job_field "$BRIEFING" '.id')"
run_entrypoint --store "$store" HERMES_CRON_SCHEDULE='30 6 * * 1-5'
assert_equals "briefings" "1" "$(store_count_named "$BRIEFING")"
assert_equals "the same job" "$first_id" "$(store_job_field "$BRIEFING" '.id')"
assert_equals "the new schedule" "30 6 * * 1-5" "$(store_job_field "$BRIEFING" '.schedule')"
assert_contains "it is logged as updated" "$(run_log)" "cron: updated ${BRIEFING} ${first_id}"
case_end

case_start "should_carry_the_new_timezone_on_the_same_job_when_the_timezone_changes"
store="$(new_store)"
run_entrypoint --store "$store"
first_id="$(store_job_field "$BRIEFING" '.id')"
run_entrypoint --store "$store" HERMES_TIMEZONE='Australia/Melbourne'
assert_equals "the same job" "$first_id" "$(store_job_field "$BRIEFING" '.id')"
assert_equals "the new timezone" "Australia/Melbourne" "$(store_job_field "$BRIEFING" '.tz')"
case_end

case_start "should_carry_the_new_target_on_the_same_job_when_the_target_changes"
store="$(new_store)"
run_entrypoint --store "$store" HERMES_BRIEFING_CHANNEL=slack HERMES_BRIEFING_TO='channel:C0123ABCDE'
first_id="$(store_job_field "$BRIEFING" '.id')"
run_entrypoint --store "$store" HERMES_BRIEFING_CHANNEL=telegram HERMES_BRIEFING_TO='-1001234567890'
assert_equals "the same job" "$first_id" "$(store_job_field "$BRIEFING" '.id')"
assert_equals "the new channel" "telegram" "$(store_job_field "$BRIEFING" '.channel')"
assert_equals "the new target" "-1001234567890" "$(store_job_field "$BRIEFING" '.to')"
case_end

case_start "should_carry_the_new_prompt_on_the_same_job_when_the_prompt_changes"
store="$(new_store)"
run_entrypoint --store "$store"
first_id="$(store_job_field "$BRIEFING" '.id')"
store_edit "$store" '.[0].prompt = "an older image'"'"'s briefing prompt"'
run_entrypoint --store "$store"
assert_equals "the same job" "$first_id" "$(store_job_field "$BRIEFING" '.id')"
assert_contains "the current prompt" "$(store_job_field "$BRIEFING" '.prompt')" "Run hermes-check"
assert_contains "it is logged as updated" "$(run_log)" "cron: updated ${BRIEFING} ${first_id}"
case_end

case_start "should_restore_a_fresh_registrations_delivery_when_the_target_is_removed"
run_entrypoint
fresh="$(store_job_field "$BRIEFING" '[.announce, .channel, .to] | tostring')"
store="$(new_store)"
run_entrypoint --store "$store" HERMES_BRIEFING_CHANNEL=slack HERMES_BRIEFING_TO='channel:C0123ABCDE'
run_entrypoint --store "$store"
assert_equals "delivery, as a fresh registration has it" "$fresh" \
  "$(store_job_field "$BRIEFING" '[.announce, .channel, .to] | tostring')"
case_end

case_start "should_keep_a_disabled_briefing_disabled_when_the_container_restarts"
store="$(new_store)"
run_entrypoint --store "$store"
store_edit "$store" '.[0].enabled = false'
run_entrypoint --store "$store"
assert_equals "still disabled" "false" "$(store_job_field "$BRIEFING" '.enabled')"
assert_not_contains "no --disabled was needed" "$(stub_calls create)" '"--disabled"'
assert_contains "and nothing changed" "$(run_log)" "cron: ${BRIEFING} unchanged"
case_end

case_start "should_keep_a_disabled_briefing_disabled_when_the_schedule_changes"
store="$(new_store)"
run_entrypoint --store "$store"
store_edit "$store" '.[0].enabled = false'
run_entrypoint --store "$store" HERMES_CRON_SCHEDULE='30 6 * * 1-5'
assert_equals "the new schedule" "30 6 * * 1-5" "$(store_job_field "$BRIEFING" '.schedule')"
assert_equals "still disabled" "false" "$(store_job_field "$BRIEFING" '.enabled')"
case_end

case_start "should_replace_a_hand_edit_when_the_container_restarts"
store="$(new_store)"
run_entrypoint --store "$store"
first_id="$(store_job_field "$BRIEFING" '.id')"
fresh="$(store_job_field "$BRIEFING" '[.announce, .channel, .to] | tostring')"
store_edit "$store" '.[0].schedule = "45 9 * * *" | .[0].prompt = "edited by hand"
  | .[0].announce = true | .[0].channel = "slack" | .[0].to = "channel:CHANDEDIT"'
run_entrypoint --store "$store"
assert_equals "the same job" "$first_id" "$(store_job_field "$BRIEFING" '.id')"
assert_equals "the environment's schedule" "0 8 * * *" "$(store_job_field "$BRIEFING" '.schedule')"
assert_contains "the image's prompt" "$(store_job_field "$BRIEFING" '.prompt')" "Run hermes-check"
assert_equals "the environment's delivery" "$fresh" \
  "$(store_job_field "$BRIEFING" '[.announce, .channel, .to] | tostring')"
case_end

case_start "should_recognise_the_declared_briefing_when_the_operator_renamed_it"
store="$(new_store)"
seed_store "$store" <<'SEEDED'
[
  { "id": "job-declared", "declarationKey": "hermes:morning-briefing", "name": "daily digest",
    "schedule": "0 8 * * *", "staggerMs": 0, "enabled": true },
  { "id": "job-unkeyed", "name": "morning-briefing", "schedule": "0 8 * * *", "enabled": false }
]
SEEDED
run_entrypoint --store "$store"
assert_equals "still enabled" "true" "$(store_field_of job-declared '.enabled')"
assert_equals "still renamed" "daily digest" "$(store_field_of job-declared '.name')"
assert_not_contains "not declared disabled" "$(stub_calls create)" '"--disabled"'
assert_equals "the leftover is gone" "null" "$(store_field_of job-unkeyed '.id')"
assert_contains "the declared job is named in the log" "$RUN_OUT" "${BRIEFING} job-declared"
case_end

case_start "should_read_a_listing_larger_than_an_environment_variable_can_hold"
store="$(new_store)"
node -e "
  const jobs = [];
  for (let i = 0; i < 160; i += 1) {
    jobs.push({ id: 'job-other-' + i, name: 'other ' + i, schedule: '0 * * * *',
      description: 'x'.repeat(1200), enabled: true });
  }
  require('fs').writeFileSync(process.argv[1], JSON.stringify(jobs));
" "${store}/jobs.json"
run_entrypoint --store "$store"
assert_equals "the listing really is that large" "yes" \
  "$([ "$(stat -c %s "${store}/jobs.json")" -gt 131072 ] && echo yes || echo no)"
assert_contains "it registered" "$RUN_OUT" "cron: registered ${BRIEFING}"
case_end

case_start "should_declare_under_a_key_outside_the_reserved_namespaces"
run_entrypoint
key="$(declared_key)"
assert_equals "the key" "$KEY" "$key"
case "$key" in
  heartbeat-task:* | skill-collection-review:*) fail "the key ${key} is in a reserved namespace" ;;
esac
case_end

case_start "should_report_an_unavailable_outcome_when_create_output_does_not_parse"
run_entrypoint OPENCLAW_STUB_CREATE_OUTPUT=garbage
id="$(store_job_field "$BRIEFING" '.id')"
assert_contains "outcome unavailable" "$(run_log)" "cron: declared ${BRIEFING} ${id}; outcome unavailable"
assert_not_contains "no outcome is guessed" "$(run_log)" "cron: registered"
case_end

case_start "should_read_the_outcome_when_create_warns_on_stderr"
run_entrypoint
assert_contains "the outcome was read" "$(run_log)" "cron: registered ${BRIEFING}"
assert_not_contains "the warning is not logged" "$(run_log)" "No --agent specified"
case_end

case_start "should_say_the_briefing_is_not_scheduled_when_giving_up_with_none_in_place"
run_entrypoint OPENCLAW_STUB_CREATE_FAILS=yes
assert_contains "not scheduled" "$RUN_ERR" "cron: giving up after 2 attempts; briefing not scheduled"
assert_contains "the gateway's reason" "$RUN_ERR" "operator.admin required"
case_end

case_start "should_say_the_briefing_was_left_as_it_was_when_giving_up_with_one_in_place"
store="$(new_store)"
run_entrypoint --store "$store"
run_entrypoint --store "$store" OPENCLAW_STUB_CREATE_FAILS=yes HERMES_CRON_SCHEDULE='30 6 * * 1-5'
assert_contains "left as it was" "$RUN_ERR" "cron: giving up after 2 attempts; briefing left as it was"
assert_not_contains "not called unscheduled" "$RUN_ERR" "briefing not scheduled"
assert_equals "still the old schedule" "0 8 * * *" "$(store_job_field "$BRIEFING" '.schedule')"
case_end

case_start "should_say_the_declaration_is_unconfirmed_when_giving_up_after_create_said_yes"
run_entrypoint OPENCLAW_STUB_CREATE_SILENT=yes
assert_contains "unconfirmed" "$RUN_ERR" "cron: giving up after 2 attempts; briefing declared but not confirmed"
case_end

case_start "should_say_the_declaration_timed_out_when_create_never_answers"
run_entrypoint OPENCLAW_STUB_HANG=create HERMES_CRON_REGISTER_ATTEMPTS=1
assert_contains "timed out" "$RUN_ERR" "cron: registration attempt 1/1 failed: timed out"
assert_not_contains "the warning is not the reason" "$RUN_ERR" "No --agent specified"
case_end

case_start "should_take_the_reason_from_the_json_when_create_is_refused"
run_entrypoint OPENCLAW_STUB_CREATE_FAILS=yes
assert_contains "the reason" "$RUN_ERR" \
  "cron: registration attempt 1/2 failed: stub-openclaw: gateway refused: operator.admin required"
assert_not_contains "no banner" "$RUN_ERR" "[openclaw]"
assert_not_contains "no warning" "$RUN_ERR" "No --agent specified"
case_end

case_start "should_start_the_gateway_when_the_declaration_fails"
run_entrypoint OPENCLAW_STUB_CREATE_FAILS=yes
assert_equals "entrypoint exit status" "0" "$RUN_STATUS"
if ! gateway_started; then
  fail "the gateway should have started"
fi
case_end

case_start "should_emit_exactly_one_terminal_line_on_every_path"
store="$(new_store)"
paths=0
for variant in \
  '' \
  '' \
  'HERMES_CRON_SCHEDULE=30 6 * * 1-5' \
  'OPENCLAW_STUB_CREATE_OUTPUT=garbage' \
  'OPENCLAW_STUB_CREATE_FAILS=yes'; do
  if [ -n "$variant" ]; then
    run_entrypoint --store "$store" "$variant"
  else
    run_entrypoint --store "$store"
  fi
  assert_equals "terminal lines for '${variant:-no change}'" "1" "$(terminal_line_count)"
  paths=$((paths + 1))
done
run_entrypoint OPENCLAW_STUB_CREATE_FAILS=yes
assert_equals "terminal lines when nothing could be scheduled" "1" "$(terminal_line_count)"
run_entrypoint OPENCLAW_STUB_LIST_FAILS=yes
assert_equals "terminal lines when the listing could not be read" "1" "$(terminal_line_count)"
run_entrypoint OPENCLAW_STUB_CREATE_SILENT=yes
assert_equals "terminal lines when the declaration was never listed" "1" "$(terminal_line_count)"
run_entrypoint OPENCLAW_STUB_HANG=create HERMES_CRON_REGISTER_ATTEMPTS=1
assert_equals "terminal lines when create timed out" "1" "$(terminal_line_count)"
run_entrypoint OPENCLAW_STUB_GATEWAY_READY=no
assert_equals "terminal lines when the gateway never became ready" "1" "$(terminal_line_count)"
store="$(new_store)"
seed_store "$store" <<'SEEDED'
[ { "id": "job-unkeyed", "name": "morning-briefing", "schedule": "0 8 * * *", "enabled": true } ]
SEEDED
run_entrypoint --store "$store" OPENCLAW_STUB_REMOVE_FAILS=yes
assert_equals "terminal lines when a removal failed" "1" "$(terminal_line_count)"
run_entrypoint --store "$store"
assert_equals "terminal lines when a leftover was replaced" "1" "$(terminal_line_count)"
assert_equals "starts in the restart sequence" "5" "$paths"
case_end

report_totals "convergence-test"
