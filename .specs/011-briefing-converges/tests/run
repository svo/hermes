#!/usr/bin/env bash
#
# Runs every check for 011. Accumulates failures rather than stopping at the
# first, so one run reveals every problem.
#
#   .specs/011-briefing-converges/tests/run
#
# Not a `bin/test` check, following 002–004 and 007–009: adding one would run
# this whole suite inside every disposable repository 006's own cases build.
# The scripts here are still linted by the gate, which discovers by shebang
# rather than by extension.

set -uo pipefail

tests_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${tests_dir}/../../.." && pwd)"
entrypoint="${repo_root}/infrastructure/ansible/roles/openclaw/files/entrypoint.sh"

failed=()

check() {
  local name="$1"
  shift
  printf '\n== %s ==\n' "$name"
  if "$@"; then
    printf 'PASS %s\n' "$name"
  else
    printf 'FAIL %s\n' "$name" >&2
    failed+=("$name")
  fi
}

check "bash -n entrypoint.sh" bash -n "$entrypoint"
check "shellcheck entrypoint.sh" shellcheck -s bash "$entrypoint"
check "shellcheck stub-openclaw" shellcheck -s bash "${tests_dir}/stub-openclaw"
check "convergence-test" bash "${tests_dir}/convergence-test"
check "adoption-test" bash "${tests_dir}/adoption-test"

printf '\n'
if [ ${#failed[@]} -eq 0 ]; then
  printf 'All 011 checks passed.\n'
  exit 0
fi

printf 'Failing checks:\n' >&2
printf '  %s\n' "${failed[@]}" >&2
exit 1
