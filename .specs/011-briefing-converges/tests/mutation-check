#!/usr/bin/env bash
#
# Sensitivity check. Not part of `run`: it is slow, and it is a check on the
# cases rather than on the entrypoint.
#
# Each mutation changes exactly one behaviour of the registrar in a copy of
# entrypoint.sh and asserts that at least one case notices. A mutation nothing
# catches is a hole in the suite.
#
# This is 003's script with 011's suites and 011's mutations. 003 keeps its own
# for the behaviour 003 still owns: readiness, budgets, timeouts, delivery
# validation and the prompt.
#
#   .specs/011-briefing-converges/tests/mutation-check [name-substring]
#
# With an argument, only mutations whose name contains it are run — the whole
# set takes a while, and this is how you re-check one after editing its anchor.
#
# Every mutation's anchor is asserted to match exactly once first. 002 learned
# that the hard way: two of its mutations anchored on a string that also
# occurred in a neighbouring block, so they mutated code nothing there tested
# and read as uncaught.

# The anchors below are literal lines of entrypoint.sh, so every $ in them is
# meant to stay a $. Single quotes are the point.
# shellcheck disable=SC2016

set -uo pipefail

tests_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${tests_dir}/../../.." && pwd)"
original="${repo_root}/infrastructure/ansible/roles/openclaw/files/entrypoint.sh"

only="${1:-}"

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

caught=0
missed=()
skipped=0

# Nothing is mutated for a name the filter excludes.
selected() {
  if [ -z "$only" ]; then
    return 0
  fi
  case "$1" in
    *"$only"*) return 0 ;;
    *) skipped=$((skipped + 1)); return 1 ;;
  esac
}

# mutate <name> <anchor> <replacement>
#
# The anchor is a fixed string matched whole-line-substring; the replacement is
# substituted for the whole line, or the line is deleted when it is the literal
# DELETE.
mutate() {
  local name="$1" anchor="$2" replacement="$3"
  local mutant="${work}/entrypoint.sh" hits

  selected "$name" || return 0

  hits="$(grep -cF -- "$anchor" "$original")"
  if [ "$hits" -ne 1 ]; then
    printf 'ANCHOR %s matched %s lines, expected exactly 1 — mutation not applied\n' \
      "$name" "$hits" >&2
    missed+=("$name (bad anchor)")
    return
  fi

  ANCHOR="$anchor" REPLACEMENT="$replacement" node -e "
    const fs = require('fs');
    const lines = fs.readFileSync(process.argv[1], 'utf8').split('\n');
    const anchor = process.env.ANCHOR;
    const replacement = process.env.REPLACEMENT;
    const out = [];
    for (const line of lines) {
      if (line.includes(anchor) === false) { out.push(line); continue; }
      if (replacement !== 'DELETE') out.push(replacement);
    }
    fs.writeFileSync(process.argv[2], out.join('\n'));
  " "$original" "$mutant"

  run_mutant "$name" "$mutant"
}

run_mutant() {
  local name="$1" mutant="$2"

  if ! bash -n "$mutant" 2>/dev/null; then
    printf 'SKIP  %s (mutant does not parse)\n' "$name" >&2
    missed+=("$name (mutant does not parse)")
    return
  fi

  # convergence-test first, and adoption-test only if nothing has caught it
  # yet. A mutation is caught when any case catches it.
  local output
  output="$(ENTRYPOINT="$mutant" bash "${tests_dir}/convergence-test" 2>&1)"
  if ! printf '%s' "$output" | grep -q '^FAIL '; then
    output="$output
$(ENTRYPOINT="$mutant" bash "${tests_dir}/adoption-test" 2>&1)"
  fi

  # A mutant that never terminates leaves its registrar polling after the run.
  # The mutant's path is unique to this iteration, so this matches only it.
  pkill -f "$mutant" 2>/dev/null || true

  if printf '%s' "$output" | grep -q '^FAIL '; then
    printf 'CAUGHT   %s\n' "$name"
    printf '%s' "$output" | grep '^FAIL ' | sed 's/^/           by /'
    caught=$((caught + 1))
  else
    printf 'UNCAUGHT %s\n' "$name" >&2
    missed+=("$name")
  fi
}

# Mutation scoring reads FAIL lines out of the mutant run, so a suite that is
# already failing would credit every mutation — including one that changes
# nothing — as caught, and the script would exit 0. The baseline is asserted
# green first, under the same budget the mutants get.
printf 'Checking the baseline is green before mutating anything.\n'
if ! baseline="$(ENTRYPOINT="$original" bash "${tests_dir}/convergence-test" 2>&1
                 ENTRYPOINT="$original" bash "${tests_dir}/adoption-test" 2>&1)" ||
   printf '%s' "$baseline" | grep -q '^FAIL '; then
  printf 'The suites do not pass against the unmutated entrypoint, so nothing can be\n' >&2
  printf 'scored. Fix these first:\n' >&2
  printf '%s' "$baseline" | grep '^FAIL ' | sed 's/^/  /' >&2
  exit 1
fi
printf 'Baseline is green.\n\n'

printf 'Mutating the registrar one behaviour at a time.\n'
printf 'Each mutation must be caught by at least one case.\n\n'

mutate 'declares without the key' \
  '  --declaration-key "$briefing_declaration_key"' \
  'DELETE'

# B2: with no stagger stored, every start's first declaration writes.
mutate 'declares without --exact' \
  '  --exact' \
  'DELETE'

mutate 'removes before declaring' \
  '        declare_args=("${briefing_create_args[@]}")' \
  '        remove_unkeyed_briefings "${unkeyed_ids[@]}"; declare_args=("${briefing_create_args[@]}")'

# On create's word, before a listing shows the key.
mutate 'removes without confirming' \
  "          declared='yes'" \
  "          declared='yes'; remove_unkeyed_briefings \"\${unkeyed_ids[@]}\""

mutate 'removes a foreign-keyed job' \
  '          const unkeyed = row.name === process.env.BRIEFING_NAME && (row.declarationKey === undefined || row.declarationKey === null);' \
  '          const unkeyed = row.name === process.env.BRIEFING_NAME && !ours;'

# A declaration leaves the name alone, so a renamed job is still the briefing.
mutate 'matches the declared job by name as well as key' \
  '          const ours = row.declarationKey === process.env.BRIEFING_KEY;' \
  '          const ours = row.name === process.env.BRIEFING_NAME && row.declarationKey === process.env.BRIEFING_KEY;'

# A no-op rather than DELETE: the line is the whole body of its `if`.
mutate 'drops --disabled on adoption' \
  '          declare_args+=(--disabled)' \
  '          :'

mutate 'passes --disabled whenever any unkeyed job is disabled' \
  '        if [ "$ours_count" -eq 0 ] && [ "${#unkeyed_ids[@]}" -gt 0 ] && [ "$unkeyed_enabled" -eq 0 ]; then' \
  '        if [ "${#unkeyed_ids[@]}" -gt "$unkeyed_enabled" ]; then'

mutate 'tolerates a bare-array listing' \
  '        if (!isObject(listing)) process.exit(2);' \
  '        if (Array.isArray(listing)) listing = { jobs: listing };'

mutate 'reads one page as the whole store' \
  '        if (listing.hasMore === true) process.exit(2);' \
  'DELETE'

mutate 'merges stderr into the outcome' \
  'declare_output="$(timeout "$briefing_create_timeout" openclaw "${declare_args[@]}" 2>"$briefing_stderr")" ||' \
  '        declare_output="$(timeout "$briefing_create_timeout" openclaw "${declare_args[@]}" 2>&1)" ||'

mutate 'reports every outcome as registered' \
  '        case "$outcome" in' \
  '        outcome=created; case "$outcome" in'

# The confirming read is what is retried after a declaration that succeeded.
# Clearing the flag there retries the declaration instead, once per attempt.
mutate 'declares again after a declare that succeeded' \
  '        reason="declaration reported success but no automation carries ${briefing_declaration_key}"' \
  "        declared='no'; reason=\"declaration reported success but no automation carries \${briefing_declaration_key}\""

mutate 'drops the id from the terminal line' \
  '        remove_unkeyed_briefings "${unkeyed_ids[@]}"' \
  '        remove_unkeyed_briefings "${unkeyed_ids[@]}"; ours_id=""'

mutate 'calls a briefing left running unscheduled' \
  "  elif [ \"\$seen_briefing\" = 'yes' ]; then" \
  '  elif false; then'

mutate 'calls an unconfirmed declaration something it is not known to be' \
  "  if [ \"\$declared\" = 'yes' ]; then" \
  '  if false; then'

mutate 'takes the reason from stderr when the JSON has one' \
  "  )\" || message=''" \
  "  )\"; message=''"

# A hung create has printed only the --agent warning.
mutate 'reports a timeout as whatever stderr held' \
  '  if [ -z "$message" ] && [ "$2" -eq 124 ]; then' \
  '  if false; then'

printf '\n%d caught, %d not caught' "$caught" "${#missed[@]}"
if [ "$skipped" -gt 0 ]; then
  printf ", %d skipped by the '%s' filter" "$skipped" "$only"
fi
printf '.\n'
if [ ${#missed[@]} -eq 0 ]; then
  exit 0
fi
printf 'Mutations no case noticed:\n' >&2
printf '  %s\n' "${missed[@]}" >&2
exit 1
