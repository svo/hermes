#!/usr/bin/env bash
#
# Runs every check for 001. Accumulates failures rather than stopping at the
# first, so one run reveals every problem.
#
# 006's `bin/test` should invoke this file. 005's `bin/hermes-check-test` will
# supersede the stubs here; when it does, point these cases at that harness and
# delete the stubs rather than keeping two.

set -uo pipefail

tests_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
hermes_check="$(cd -- "${tests_dir}/../../.." && pwd)/infrastructure/ansible/roles/openclaw/files/hermes-check"
entrypoint="$(cd -- "${tests_dir}/../../.." && pwd)/infrastructure/ansible/roles/openclaw/files/entrypoint.sh"

failed=()

check() {
  local name="$1"
  shift
  printf '\n== %s ==\n' "$name"
  if "$@"; then
    printf 'PASS %s\n' "$name"
  else
    printf 'FAIL %s\n' "$name" >&2
    failed+=("$name")
  fi
}

check "bash -n hermes-check" bash -n "$hermes_check"
check "bash -n entrypoint.sh" bash -n "$entrypoint"
check "sanitize-unit-test" bash "${tests_dir}/sanitize-unit-test"
check "sanitize-injection-test" bash "${tests_dir}/sanitize-injection-test"
check "fence-drift-test" bash "${tests_dir}/fence-drift-test"

printf '\n'
if [ ${#failed[@]} -eq 0 ]; then
  printf 'All 001 checks passed.\n'
  exit 0
fi

printf 'Failing checks:\n' >&2
printf '  %s\n' "${failed[@]}" >&2
exit 1
