#!/usr/bin/env bash
#
# Stand-in for the urgency classifier, placed ahead of the real binary on PATH.
#
# 001 changes nothing about classification, but the real model is 800 MB and
# costs about a second per message, and it is present on a developer machine
# and absent in CI. Stubbing it makes bucket assignment — and so the assertions
# that count emitted lines — identical everywhere.
#
#   FASTTEXT_LABEL  label suffix to report (default: not_urgent)

set -uo pipefail

cat >/dev/null
printf '__label__%s\n' "${FASTTEXT_LABEL:-not_urgent}"
