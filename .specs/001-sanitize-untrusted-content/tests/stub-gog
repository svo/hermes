#!/usr/bin/env bash
#
# Minimal stand-in for `gog`, placed ahead of the real binary on PATH so that
# `hermes-check` can be run end to end with no credentials and no network.
#
# 005 owns the full harness (`bin/hermes-check-test`). This is the smallest
# thing that makes 001's acceptance criteria verifiable before that lands, and
# it follows the environment contract 005's PLAN describes — widened so a
# single run can serve both the gmail and the calendar call.
#
#   GOG_FIXTURE_GMAIL     file printed for `gog gmail ...`
#   GOG_FIXTURE_CALENDAR  file printed for `gog calendar ...`
#   GOG_FIXTURE           fallback for either
#   GOG_FIXTURE_EXIT      exit status (default 0)
#
# A value that is not a readable file is printed verbatim, so a case can feed
# malformed output without keeping a file for it.

set -uo pipefail

case "${1:-}" in
  gmail) fixture="${GOG_FIXTURE_GMAIL:-${GOG_FIXTURE:-}}" ;;
  calendar) fixture="${GOG_FIXTURE_CALENDAR:-${GOG_FIXTURE:-}}" ;;
  *) fixture="${GOG_FIXTURE:-}" ;;
esac

if [ -n "$fixture" ]; then
  if [ -f "$fixture" ]; then
    cat "$fixture"
  else
    printf '%s\n' "$fixture"
  fi
fi

exit "${GOG_FIXTURE_EXIT:-0}"
